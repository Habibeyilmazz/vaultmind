    "start": "node src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "marked": "^18.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "playwright": "1.65.1",
    "typescript": "^7.0.2"
  }
