{
  "name": "vaultmind",
  "version": "0.1.0",
  "description": "Local-first semantic search and MCP server for a Markdown/Obsidian vault",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vaultmind": "dist/cli.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
